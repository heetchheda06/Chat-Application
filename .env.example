# WaveChat Environment Configuration Example
PORT=3000
NODE_ENV=development

# MongoDB URI (Set your local or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/wavechat

# JWT Secret Key for Session Authentication
JWT_SECRET=wavechat_super_secret_jwt_key_2026_wmc_project

# Automatic local JSON fallback if MongoDB server is offline
USE_LOCAL_STORAGE_FALLBACK=true
